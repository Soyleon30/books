MYSQL_HOST=host.docker.internal
MYSQL_PORT=3319
MYSQL_USER=root
MYSQL_PASSWORD=MySql@2024
MYSQL_DATABASE=books

# 对外端口（可选）
WEB_PORT=8080
API_PORT=3000
API_UPSTREAM=backend:3000

# 首次启动自动创建管理员（仅 users 表为空时）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=a123456

# 书目刮削（可选）
# data.isbn.work 的 appKey（有调用次数限制，勿提交到 git）
# ISBN_WORK_APP_KEY=
# 自定义元数据 API，URL 中可用 {isbn}
# BOOK_META_API=
# DOUBAN_API_KEY=

# 阿里云 OCR 通用文字识别（书脊识书；勿提交真实 Key）
# ALIYUN_OCR_ACCESS_KEY_ID=
# ALIYUN_OCR_ACCESS_KEY_SECRET=
# ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
# ALIYUN_OCR_API=RecognizeGeneral

# PaddleOCR 官方 API（AI Studio access token）
# PADDLE_TOKEN=
# 等同：PADDLEOCR_ACCESS_TOKEN=
# 多模型（逗号分隔）：PP-OCRv5,PP-OCRv6  可选再加 PaddleOCR-VL-1.6
# PADDLE_OCR_MODELS=PP-OCRv5,PP-OCRv6
# PADDLE_OCR_MODEL=PP-OCRv5

# OCR 引擎：auto | compare | paddle | paddle_v5 | paddle_v6 | paddle_vl | aliyun | tesseract
# auto：Paddle → 阿里 → Tesseract；compare：多引擎都跑并择优
# OCR_ENGINE=auto
# OCR_COMPARE=0
# 网络失败重试次数（阿里/Paddle 各会再试）
# OCR_RETRY=1
# OCR_RETRY_DELAY_MS=1000
