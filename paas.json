{
  "name": "图书管理",
  "slug": "book-scanner",
  "version": "1.9.5",
  "description": "图书管理（ISBN 扫码入库）",
  "deploy_mode": "stack",
  "network": "book-scanner-net",
  "services": [
    {
      "key": "api",
      "name": "API",
      "context": "backend",
      "dockerfile": "Dockerfile",
      "image": "book-scanner-api:latest",
      "container_name": "book-scanner-api",
      "host_port": 3000,
      "container_port": 3000,
      "env_keys": [
        "MYSQL_HOST",
        "MYSQL_PORT",
        "MYSQL_USER",
        "MYSQL_PASSWORD",
        "MYSQL_DATABASE",
        "PORT",
        "ADMIN_USERNAME",
        "ADMIN_PASSWORD"
      ]
    },
    {
      "key": "web",
      "name": "Web",
      "context": "frontend",
      "dockerfile": "Dockerfile",
      "image": "book-scanner-web:latest",
      "container_name": "book-scanner-web",
      "host_port": 8080,
      "container_port": 80,
      "env": {
        "API_UPSTREAM": "book-scanner-api:3000"
      }
    }
  ],
  "env_example": {
    "MYSQL_HOST": "host.docker.internal",
    "MYSQL_PORT": "3319",
    "MYSQL_USER": "root",
    "MYSQL_PASSWORD": "MySql@2024",
    "MYSQL_DATABASE": "books",
    "PORT": "3000",
    "ADMIN_USERNAME": "admin",
    "ADMIN_PASSWORD": "a123456"
  }
}
