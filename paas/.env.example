PORT=8083

# PaaS 元数据 MySQL（可与图书库同机不同库）
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=lite_paas

# 预置「书本扫描器」默认图书库连接（可在面板再改）
# BOOKS_MYSQL_HOST=8.157.18.157
# BOOKS_MYSQL_PORT=3319
# BOOKS_MYSQL_USER=root
# BOOKS_MYSQL_PASSWORD=
# BOOKS_MYSQL_DATABASE=books

# 可选：强制 runtime（podman | docker），默认自动检测
# CONTAINER_RUNTIME=podman

# 数据目录（上传的镜像 tar）
# DATA_DIR=/home/paas/data

# 最大上传 MB
MAX_UPLOAD_MB=2048
