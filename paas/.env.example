PORT=8083

# PaaS 元数据 MySQL（容器内用 host.docker.internal 访问宿主机/同机 MySQL）
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3319
MYSQL_USER=root
MYSQL_PASSWORD=MySql@2024
MYSQL_DATABASE=lite_paas

# 预置「书本扫描器」默认图书库
BOOKS_MYSQL_HOST=host.docker.internal
BOOKS_MYSQL_PORT=3319
BOOKS_MYSQL_USER=root
BOOKS_MYSQL_PASSWORD=MySql@2024
BOOKS_MYSQL_DATABASE=books

